rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Avatars: only the owning user can read/write
    match /avatars/{userId}/{filename} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Item images: authenticated users only (list-level access enforced via Firestore)
    match /lists/{listId}/items/{itemId}/{filename} {
      allow read, write: if request.auth != null;
    }
  }
}
